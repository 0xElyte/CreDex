# ═══════════════════════════════════════════════════════════════════════════════
# CreDex — Go Backend .env
# File location: credex-backend/.env  (same directory as main.go)
# Default port: 8000
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
# Set to "release" in production (disables Gin debug output)
GIN_MODE=debug

# ── Python Scoring Engine ─────────────────────────────────────────────────────
# Must match PORT in scoring-engine.env
SCORING_ENGINE_URL=http://localhost:8001

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from @BotFather → /newbot
# Used for: loan approval, repayment confirmations, default warnings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Ethereum Sepolia RPC ──────────────────────────────────────────────────────
# Standard EVM RPC — used by the EVM relayer to submit relay() transactions
# to RelayedCreditVerifier.sol on Ethereum Sepolia.
# Replace YOUR_ALCHEMY_API_KEY with your actual Alchemy key.
EVM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY

# ── Solidity Contract Addresses ───────────────────────────────────────────────
# Deploy with: forge script script/DeployCredexProtocol.s.sol --broadcast --rpc-url $EVM_RPC_URL
# Then paste the deployed addresses here.
#
# CredexLending.sol — the main lending contract users call requestLoan() on
LENDING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# CredexSBT.sol — soulbound NFT identity token
SBT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# RelayedCreditVerifier.sol — receives relay() calls from this backend
RELAYED_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# ── Relayer Signing Wallet ────────────────────────────────────────────────────
# A dedicated wallet used ONLY for signing relay() transactions.
# NEVER use a personal wallet or a wallet holding real funds.
#
# Generate a fresh key:
#   openssl rand -hex 32
#
# Then derive the address:
#   node -e "const {ethers}=require('ethers'); console.log(new ethers.Wallet('0x<KEY>').address)"
#
# Fund this wallet with a small amount of Sepolia ETH for gas:
#   https://sepoliafaucet.com
RELAYER_PRIVATE_KEY=your_generated_private_key_here
# Public address of the relayer wallet — set as initialRelayer during deploy
RELAYER_ADDRESS=0x0000000000000000000000000000000000000000

# ── Starknet Sepolia ──────────────────────────────────────────────────────────
# Used by the Starknet client to call verify_credit() on the Cairo contract.
# Alchemy Starknet Sepolia endpoint:
STARKNET_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_7/YOUR_ALCHEMY_API_KEY
# Cairo CreditVerifier contract deployed on Starknet Sepolia
STARKNET_VERIFIER_ADDRESS=0x05655bb69addbb8a48a19fe4e3251dcc0058761052c7032aead67ea6d05391fe

# ── fhEVM / Zama (legacy — kept for reference) ───────────────────────────────
# These were the original FHE integration endpoints.
# The request flow now uses Starknet → EVM relay instead.
# Leave as-is unless you're re-enabling the FHE path.
FHEVM_RPC_URL=https://devnet.zama.ai
ZAMA_RELAYER_URL=https://relayer.sepolia.zama.ai
CAIRO_PROVER_URL=https://prover.starknet-sepolia.credex.io

# ── Filecoin / Synapse ────────────────────────────────────────────────────────
# Used to store ZK proof metadata on Filecoin for verifiable audit trail.
# Get an API key at: https://console.synapse.storage
# If not configured, proof metadata storage is mocked (CID is deterministic fake).
FILECOIN_SYNAPSE_URL=https://api.synapse.filecoin.io
FILECOIN_API_KEY=your_filecoin_api_key_here
ZG_STORAGE_URL=https://rpc-storage-testnet.0g.ai
