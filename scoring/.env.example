# Copy this to .env and fill in real values

# ── Required ──────────────────────────────────────────────────────────────────
# Alchemy API key for Ethereum Sepolia
# Get one free at https://dashboard.alchemy.com
# Create app → Ethereum → Sepolia → copy the API Key
ALCHEMY_API_KEY=lEBB3O-bQnzdOLjXtCAVf

# ── Optional ──────────────────────────────────────────────────────────────────
# Chain to score against (11155111 = Sepolia, 1 = Mainnet, 137 = Polygon)
CHAIN_ID=11155111

# Comma-separated wallet addresses that have World ID verification (+100 pts)
# Add your own wallet here while testing on Sepolia
WORLD_ID_VERIFIED=0x336d27873ed36cb6b94400d046affb72623981c9

# Go backend URL (only needed if scoring engine calls back to Go)
BACKEND_URL=http://localhost:8000/api/v1

# Telegram bot token (for scoring engine alerts — optional)
TELEGRAM_BOT_TOKEN=

# Server port (must match SCORING_ENGINE_URL in Go backend .env)
PORT=8001

# Score cache TTL in seconds
SCORE_CACHE_TTL=480
